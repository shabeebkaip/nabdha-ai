# Nabda AI — environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Neon Postgres, via Vercel Marketplace) ---
# Neon connection string. Use the pooled ("-pooler") host for the app,
# Drizzle Kit migrations work fine against the same URL.
# Get it from: Vercel dashboard -> Storage -> your Neon integration -> .env.local tab
# or neon.tech console -> Connection Details.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/nabda?sslmode=require"

# --- Auth.js (NextAuth) ---
# Session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Canonical app URL Auth.js uses to build callback URLs.
# Local dev: http://localhost:3000
# Deployed: your Vercel preview/production URL.
NEXTAUTH_URL="http://localhost:3000"

# --- AI (Claude / Anthropic, via Vercel AI SDK) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-replace-me"

# --- Vercel Blob (file uploads) ---
# Created automatically when you add Blob storage to the Vercel project;
# `vercel env pull` will populate the real value.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# --- App ---
# Public site URL, used for absolute links/metadata. NEXT_PUBLIC_ = exposed to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
